<RCC>
    <qresource prefix="/aethorax/config">
        <file alias="aethorax.json">res/config/aethorax.json</file>
        <file alias="mission_commands.json">res/config/mission_commands.json</file>
    </qresource>
    <qresource prefix="/Custom/qml/QGroundControl/Controls">
        <file alias="MissionCommandDialog.qml">qml/MissionCommandDialog.qml</file>
    </qresource>
    <qresource prefix="/Custom/qml/QGroundControl/PlanView">
        <file alias="PlanViewRightPanel.qml">qml/PlanViewRightPanel.qml</file>
        <file alias="PlanView.qml">qml/PlanView.qml</file>
        <file alias="MissionSettingsEditor.qml">qml/MissionSettingsEditor.qml</file>
    </qresource>
</RCC>
